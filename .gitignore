# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/


# Added by cargo

/target

# FastF1 cache and exported data. data/ is listed as /data/* rather than /data/ so the
# derived aero coefficients can be re-included below -- git cannot un-ignore a file whose
# parent directory is itself ignored.
/cache/
/data/*

# ...except the per-track aero coefficients: two numbers per circuit, ~50 bytes each, and
# they are car-model parameters rather than bulk data. A missing one falls back to the coarse
# 3-tier downforce guess and its known ~+16% lap-time error, so the physics is not
# reproducible without them (see src/api.rs load_car_params).
!/data/*_aero_params.csv

# Compiled binary in project root
/main

# macOS metadata
.DS_Store

# Python virtual environment
.venv/

# Python bytecode cache
__pycache__/

# Machine-specific ipopt-sys build shim (bakes in this machine's Homebrew prefix);
# regenerate with scripts/setup_ipopt.sh
/.ipopt-shim/
